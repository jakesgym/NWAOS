{
  "rules": {
    "sep": {
      "saves": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "rooms": {
        "$room": {
          ".read": "auth != null",
          "meta": {
            ".write": "auth != null && ($room === 'main' || $room.matches(/^[A-Z0-9]{4,8}$/))"
          },
          "snap": {
            ".write": "auth != null && root.child('sep/rooms/' + $room + '/meta/host').val() === auth.uid"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "acts": {
            ".write": "auth != null"
          },
          "inbox": {
            "$uid": {
              ".write": "auth != null"
            }
          },
          "ev": {
            ".write": "auth != null"
          }
        }
      }
    },
    "lava": {
      "lobby": {
        ".read": "auth != null",
        "$room": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid) && (!newData.exists() || newData.child('host').val() === auth.uid)"
        }
      },
      "rooms": {
        "$room": {
          ".read": "auth != null",
          ".write": "auth != null && data.child('meta/host').val() === auth.uid && !newData.exists()",
          "meta": {
            ".write": "auth != null && (data.exists() ? data.child('host').val() === auth.uid : newData.child('host').val() === auth.uid)"
          },
          "state": {
            ".write": "auth != null && root.child('lava/rooms/' + $room + '/meta/host').val() === auth.uid"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "inputs": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        }
      }
    }
  }
}
